{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classwork-collection",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "classwork-db",
      "database_id": "eede1165-fcd4-4e23-83d6-936aaf82d99b",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "GITHUB_OWNER": "SDU-Chuck",
    "GITHUB_HOMEWORK_REPO": "Store_the_assignment",
    "GITHUB_HOMEWORK_BRANCH": "main"
  }
}
